{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "overly-aliexpress-search",
  "main": "src/index.js",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "triggers": {
    "crons": ["17 2 * * *"]
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "ANALYTICS_DB",
      "database_name": "overly-analytics",
      "database_id": "146f8155-25c4-409a-8804-5f9761bc9b04",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "SEARCH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://majeed3575.github.io",
    "ALIEXPRESS_API_ENDPOINT": "https://api-sg.aliexpress.com/sync",
    "ALIEXPRESS_TRACKING_ID": "faraj733",
    "ALIEXPRESS_TARGET_CURRENCY": "USD",
    "ALIEXPRESS_TARGET_LANGUAGE": "AR",
    "ALIEXPRESS_SHIP_TO_COUNTRY": "SA",
    "ALIEXPRESS_SEARCH_MIN_VOLUME": "1000",
    "ALIEXPRESS_SEARCH_MIN_RATING_PERCENT": "90",
    "USD_TO_SAR": "3.75"
  }
}
