{
  "manifest_version": 3,
  "name": "Overly Product Studio",
  "version": "5.0.0",
  "description": "استخراج ومراجعة ومزامنة ونشر منتجات Amazon.sa وAliExpress إلى موقع Overly.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "*://*.amazon.sa/*",
    "*://*.aliexpress.com/*",
    "*://*.aliexpress.us/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Overly Product Studio"
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
