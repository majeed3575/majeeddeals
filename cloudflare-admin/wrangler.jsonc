{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "overly-admin",
  "main": "src/index.js",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "ANALYTICS_DB",
      "database_name": "overly-analytics",
      "database_id": "146f8155-25c4-409a-8804-5f9761bc9b04"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "SITE_URL": "https://majeed3575.github.io/majeeddeals/"
  }
}
